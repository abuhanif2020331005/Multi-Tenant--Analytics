{
  "title": "Platform Business Metrics",
  "uid": "platform-business",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total HTTP Requests (all services)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(platform_http_requests_total)",
          "legendFormat": "Requests"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(platform_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(platform_http_requests_total[5m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events Ingested (outbox pending)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "platform_outbox_pending_total",
          "legendFormat": "Pending"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate-Limited Requests",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(platform_http_requests_total{status=\"429\"}[5m]))",
          "legendFormat": "Rate Limited"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 10 }] } } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Service (req/s)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(platform_http_requests_total{job=\"api-gateway\"}[1m])", "legendFormat": "api-gateway" },
        { "expr": "rate(platform_http_requests_total{job=\"auth-service\"}[1m])", "legendFormat": "auth-service" },
        { "expr": "rate(platform_http_requests_total{job=\"analytics-service\"}[1m])", "legendFormat": "analytics-service" },
        { "expr": "rate(platform_http_requests_total{job=\"event-ingestion-service\"}[1m])", "legendFormat": "event-ingestion" },
        { "expr": "rate(platform_http_requests_total{job=\"recommendation-service\"}[1m])", "legendFormat": "recommendation" },
        { "expr": "rate(platform_http_requests_total{job=\"fraud-detection-service\"}[1m])", "legendFormat": "fraud-detection" },
        { "expr": "rate(platform_http_requests_total{job=\"catalog-service\"}[1m])", "legendFormat": "catalog" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P95 Latency by Service (ms)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(platform_http_duration_ms_bucket{job=\"api-gateway\"}[5m]))", "legendFormat": "api-gateway p95" },
        { "expr": "histogram_quantile(0.95, rate(platform_http_duration_ms_bucket{job=\"auth-service\"}[5m]))", "legendFormat": "auth-service p95" },
        { "expr": "histogram_quantile(0.95, rate(platform_http_duration_ms_bucket{job=\"recommendation-service\"}[5m]))", "legendFormat": "recommendation p95" },
        { "expr": "histogram_quantile(0.95, rate(platform_http_duration_ms_bucket{job=\"fraud-detection-service\"}[5m]))", "legendFormat": "fraud-detection p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Event Pipeline Throughput",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(platform_http_requests_total{job=\"event-ingestion-service\",route=\"/ingest/events\"}[1m])", "legendFormat": "events ingested/s" },
        { "expr": "rate(platform_outbox_processed_total[1m])", "legendFormat": "events processed/s" },
        { "expr": "rate(platform_outbox_failed_total[1m])", "legendFormat": "events failed/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Recommendation & Fraud API Usage",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(platform_http_requests_total{job=\"recommendation-service\"}[1m])", "legendFormat": "recommendations/s" },
        { "expr": "rate(platform_http_requests_total{job=\"fraud-detection-service\"}[1m])", "legendFormat": "fraud checks/s" },
        { "expr": "rate(platform_http_requests_total{job=\"catalog-service\",route=\"/catalog/chat\"}[1m])", "legendFormat": "chatbot req/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Service Health Summary",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "renameByName": { "Value": "Status", "job": "Service" } } }
      ]
    }
  ]
}
